# ──────────────────────────────────────────────────
# .gitignore — Findclo (React + Vite)
# Tech stack: Vite, React 19, CSS Modules
# ──────────────────────────────────────────────────

# ── Dependencies ───────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Outputs ──────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Environment Variables ─────────────────────────
# Never commit secrets, API keys, or connection strings
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── Vite Cache ─────────────────────────────────────
.vite/
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# ── Editor / IDE ────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.DS_Store
Thumbs.db

# ── OS Files ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini
$RECYCLE.BIN/

# ── Logs ──────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test Coverage ─────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Package Manager Lock Files (keep one) ─────────
# Commit the one that matches your team's package manager.
# Delete the other two lines:
# package-lock.json  ← keep if using npm
# yarn.lock          ← keep if using yarn
# pnpm-lock.yaml     ← keep if using pnpm

# ── Storybook ─────────────────────────────────────
storybook-static/
.storybook/

# ── Temporary / Scratch ────────────────────────────
*.tmp
*.temp
.cache/
tmp/
scratch/

# ── Deployment Specific ────────────────────────────
.vercel
.netlify
.firebase/
.amplify/

# ── Testing ────────────────────────────────────────
/playwright-report/
/test-results/
/cypress/